{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aphrodite",
  "version": "0.2.1",
  "identifier": "studio.aphrodite.mela",
  "build": {
    "beforeDevCommand": "node scripts/build-vision.mjs && npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "node scripts/build-vision.mjs && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Aphrodite — Shape before you build.",
        "width": 1500,
        "height": 960,
        "minWidth": 900,
        "minHeight": 620,
        "dragDropEnabled": false,
        "theme": "Light",
        "backgroundColor": "#f5f5f1"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "dmg": {
        "background": "dmg/background.tiff",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    },
    "externalBin": [
      "bin/aphrodite-vision"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZBQ0M2ODRDRUY2NDgwOApSV1FJU1BiT2hNYXNEOW0vWm9ERFZrRzl1bXlPSkZDWG9BQkZTQ1hYS00wSUlZNkZZdVRWQkJYdwo=",
      "endpoints": [
        "https://github.com/kwakseongjae/aphrodite-mela/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
